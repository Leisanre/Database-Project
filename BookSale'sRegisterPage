<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Bookstore</title>
    <style>
        /* General Styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f1f8f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            position: relative;
        }

        .background {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('your-background-image.jpg') no-repeat center center/cover;
            z-index: 1;
        }

        /* Navbar Styles */
        .navbar {
            background-color: #2c6e49;
            color: #fff;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 2;
        }

        .navbar h1 {
            margin: 0;
        }

        .navbar a {
            text-decoration: none;
            color: inherit;
        }

        /* Register Form */
        .register-container {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 2rem 3rem;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
            position: absolute;
            z-index: 2;
            backdrop-filter: blur(8px);
        }

        .register-container h2 {
            color: #2c6e49;
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .register-container input {
            width: 100%;
            padding: 0.8rem;
            margin-bottom: 1rem;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
        }

        .register-container button {
            width: 100%;
            padding: 0.8rem;
            background-color: #2c6e49;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            margin-top: 1rem;
        }

        .register-container button:hover {
            background-color: #1f4f36;
        }

        .register-container .links {
            text-align: center;
            margin-top: 1rem;
        }

        .register-container .links a {
            color: #2c6e49;
            text-decoration: none;
            font-size: 0.9rem;
        }

        .register-container .links a:hover {
            text-decoration: underline;
        }

        /* Modal Background */
        .modal-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 999;
            backdrop-filter: blur(5px);
        }

        .login-container-modal {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 1.5rem 2.5rem;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 350px;
            position: relative;
        }

        .login-container-modal h2 {
            color: #2c6e49;
            text-align: center;
            margin-bottom: 0.8rem;
        }

        .login-container-modal input {
            width: 100%;
            padding: 0.5rem;
            margin-bottom: 0.6rem;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.85rem;
        }

        .login-container-modal button {
            width: 100%;
            padding: 0.5rem;
            background-color: #2c6e49;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 0.85rem;
            cursor: pointer;
            margin-top: 1rem;
        }

        .login-container-modal button:hover {
            background-color: #1f4f36;
        }

        .login-container-modal .links {
            text-align: center;
            margin-top: 0.8rem;
        }

        .login-container-modal .links a {
            color: #2c6e49;
            text-decoration: none;
            font-size: 0.8rem;
        }

        .login-container-modal .links a:hover {
            text-decoration: underline;
        }

        .forgot-password {
            display: block;
            text-align: center;
            font-size: 0.75rem;
            color: #2c6e49;
            margin-top: 0.8rem;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="background"></div>

    <div class="navbar">
        <a href="BookSaleTest.html">
            <h1>BookSale</h1>
        </a>
    </div>

    <div class="register-container">
        <h2>Create an Account</h2>
        <form id="register-form">
            <input type="email" name="email" placeholder="Email" required>
            <input type="text" name="first_name" placeholder="First Name" required>
            <input type="text" name="middle_name" placeholder="Middle Name" required>
            <input type="text" name="last_name" placeholder="Last Name" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Register</button>
        </form>
        <div class="links">
            <a href="javascript:void(0)" id="open-login-modal-link">Already have an account? Login here</a>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal-background" id="login-modal">
        <div class="login-container-modal">
            <h2>Sign In</h2>
            <form id="login-form">
                <input type="email" name="email" placeholder="Email" required>
                <input type="password" name="password" placeholder="Password" required>
                <a href="reset-password.html" class="forgot-password">Forgot password?</a>
                <button type="submit">Sign In</button>
            </form>
            <div class="links">
                <a href="javascript:void(0)" id="register-link">Don't have an account? Register here</a>
            </div>
        </div>
    </div>

    <script>
        // Handle form submission
        const form = document.getElementById("register-form");

        form.addEventListener("submit", function(event) {
            event.preventDefault();  // Prevent default form submission

            // Check if all required fields are filled
            const inputs = form.querySelectorAll('input');
            let isValid = true;

            inputs.forEach(input => {
                if (!input.value) {
                    isValid = false;
                }
            });

            if (isValid) {
                // Get form data
                const formData = new FormData(form);
                const userData = {};
                formData.forEach((value, key) => {
                    userData[key] = value;
                });

                // Send data to the backend (replace with your backend URL)
                fetch('http://localhost:5000/api/signup', { // Backend URL for signup API
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(userData)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show login modal after registration
                        document.getElementById("login-modal").style.display = "flex";
                    } else {
                        alert("Registration failed: " + data.message);
                    }
                })
                .catch(error => {
                    console.error("Error during registration:", error);
                });
            } else {
                alert("Please fill all the fields.");
            }
        });

        // Show modal when login link is clicked
        document.getElementById("open-login-modal-link").addEventListener("click", function() {
            document.getElementById("login-modal").style.display = "flex";
        });

        // Close modal when register link is clicked
        document.getElementById("register-link").addEventListener("click", function() {
            document.getElementById("login-modal").style.display = "none";
        });
    </script>
</body>
</html>

