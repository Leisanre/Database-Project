-- Use the BookSale database
USE BookSale;

ALTER TABLE OrderItems DROP FOREIGN KEY orderitems_ibfk_1;

-- Drop tables if they already exist to start fresh
DROP TABLE IF EXISTS Orders;
DROP TABLE IF EXISTS OrderItems;
DROP TABLE IF EXISTS Books;
DROP TABLE IF EXISTS Users;

-- Create the Users table with essential and optional columns
CREATE TABLE Users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,          -- Unique user ID
    username VARCHAR(50) NOT NULL UNIQUE,            -- Unique username for login
    password_hash VARCHAR(255) NOT NULL,             -- Hashed password for security
    email VARCHAR(100) NOT NULL UNIQUE,              -- Unique email address for communication
    first_name VARCHAR(50) NOT NULL,                 -- User's first name
    last_name VARCHAR(50) NOT NULL,                  -- User's last name
    phone_number VARCHAR(15) NULL,                   -- Optional phone number for user communication
    address VARCHAR(255) NULL,                       -- Optional address for delivery
    date_of_birth DATE NULL,                         -- Optional date of birth for insights
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- Timestamp for when the record was created
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP -- Timestamp for when the record was last updated
);

-- Create the Books table for storing book information
CREATE TABLE Books (
    book_id INT AUTO_INCREMENT PRIMARY KEY,          -- Unique book ID
    title VARCHAR(255) NOT NULL,                     -- Book title
    author VARCHAR(100) NOT NULL,                    -- Author of the book
    isbn VARCHAR(20) UNIQUE,                         -- International Standard Book Number
    publisher VARCHAR(100),                          -- Book publisher
    published_date DATE,                             -- Publication date of the book
    genre VARCHAR(50),                               -- Genre or category of the book
    price DECIMAL(10, 2) NOT NULL,                   -- Price of the book
    stock_quantity INT NOT NULL,                     -- Stock quantity of the book
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- Timestamp for when the record was created
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP -- Timestamp for when the record was last updated
);

-- Create the Orders table to manage user orders
CREATE TABLE Orders (
    order_id INT AUTO_INCREMENT PRIMARY KEY,         -- Unique order ID
    user_id INT,                                     -- Links to user who placed the order
    order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- Date when the order was placed
    total_price DECIMAL(10, 2) NOT NULL,             -- Total price of the order
    order_status VARCHAR(50) DEFAULT 'Pending',      -- Status of the order (e.g., Pending, Shipped, Delivered)
    shipping_address VARCHAR(255),                   -- Shipping address for the order
    FOREIGN KEY (user_id) REFERENCES Users(user_id)  -- Foreign key constraint linking to Users table
);

-- Create the OrderItems table to link Orders with Books (many-to-many relationship)
CREATE TABLE OrderItems (
    order_item_id INT AUTO_INCREMENT PRIMARY KEY,    -- Unique order item ID
    order_id INT,                                    -- Links to the specific order
    book_id INT,                                     -- Links to the specific book in the order
    quantity INT NOT NULL,                           -- Quantity of the book ordered
    price DECIMAL(10, 2) NOT NULL,                   -- Price of the book at the time of order
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- Timestamp for when the order item was created
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, -- Timestamp for when the order item was last updated
    FOREIGN KEY (order_id) REFERENCES Orders(order_id), -- Foreign key linking to Orders table
    FOREIGN KEY (book_id) REFERENCES Books(book_id)  -- Foreign key linking to Books table
);

