-- Query to view Users table with 12-hour time format for created_at and updated_at
SELECT 
    user_id,
    username,
    email,
    first_name,
    last_name,
    phone_number,
    address,
    date_of_birth,
    DATE_FORMAT(created_at, '%Y-%m-%d %h:%i %p') AS created_at,
    DATE_FORMAT(updated_at, '%Y-%m-%d %h:%i %p') AS updated_at
FROM Users
LIMIT 10;

-- Query to view Books table with 12-hour time format for created_at and updated_at
SELECT 
    book_id,
    title,
    author,
    isbn,
    publisher,
    published_date,
    genre,
    price,
    stock_quantity,
    DATE_FORMAT(created_at, '%Y-%m-%d %h:%i %p') AS created_at,
    DATE_FORMAT(updated_at, '%Y-%m-%d %h:%i %p') AS updated_at
FROM Books
LIMIT 10;

-- Query to view Orders table, including user info and 12-hour time format for order_date
SELECT 
    o.order_id,
    o.user_id,
    u.username,
    u.first_name,
    u.last_name,
    o.order_date,
    DATE_FORMAT(o.order_date, '%Y-%m-%d %r') AS order_date,  -- Corrected 12-hour format for order_date
    o.total_price,
    o.order_status,
    o.shipping_address
FROM Orders o
JOIN Users u ON o.user_id = u.user_id
LIMIT 10;

-- Query to view OrderItems table, including book info
SELECT 
    oi.order_item_id,
    oi.order_id,
    oi.book_id,
    b.title AS book_title,
    b.author AS book_author,
    oi.quantity,
    oi.price,
    DATE_FORMAT(oi.created_at, '%Y-%m-%d %h:%i %p') AS created_at,
    DATE_FORMAT(oi.updated_at, '%Y-%m-%d %h:%i %p') AS updated_at
FROM OrderItems oi
JOIN Books b ON oi.book_id = b.book_id
LIMIT 10;
