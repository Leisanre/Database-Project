<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookstore Homepage</title>
    <style>
        /* General Styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f1f8f4; /* Light greenish background */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            position: relative;
        }

        /* Background Image or Content */
        .background {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('your-background-image.jpg') no-repeat center center/cover;
            z-index: 1; /* Behind the login form */
        }

        /* Navbar Styles */
        .navbar {
            background-color: #2c6e49; /* Greenish */
            color: #fff;
            padding: 1rem 1.5rem; /* Smaller padding */
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 2;
        }

        .navbar h1 {
            margin: 0;
            z-index: 3; /* Ensure the logo stays above the modal */
        }

        /* Remove underline and color from the link around the logo */
        .navbar a {
            text-decoration: none; /* Remove underline */
            color: inherit; /* Inherit color from navbar */
            z-index: 3; /* Ensure the link stays above the modal */
        }

        /* Login Button Styles */
        .login-container {
            position: relative;
            display: inline-block;
        }

        .login-button {
            color: #fff;
            text-decoration: none;
            font-size: 0.8rem; /* Reduced font size */
            padding: 0.3rem 0.6rem; /* Smaller padding */
            border: 1px solid #fff;
            border-radius: 5px;
            background-color: #2c6e49;
            cursor: pointer;
        }

        .login-button:hover {
            background-color: #1f4f36;
        }

        /* Modal Background */
        .modal-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6); /* Dark transparent background */
            display: none; /* Hidden by default */
            justify-content: center;
            align-items: center;
            z-index: 999; /* Ensures modal appears in front */
            backdrop-filter: blur(5px); /* Apply blur effect on background */
        }

        /* Login Form Container */
        .login-container-modal {
            background-color: rgba(255, 255, 255, 0.9); /* Slightly transparent white background */
            padding: 1.5rem 2.5rem;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 350px;
            position: relative;
            z-index: 2; /* On top of the background */
        }

        .login-container-modal h2 {
            color: #2c6e49;
            text-align: center;
            margin-bottom: 0.8rem;
        }

        .login-container-modal input {
            width: 100%;
            padding: 0.5rem;
            margin-bottom: 0.6rem;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.85rem;
        }

        .login-container-modal button {
            width: 100%;
            padding: 0.5rem;
            background-color: #2c6e49;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 0.85rem;
            cursor: pointer;
            margin-top: 1rem;
        }

        .login-container-modal button:hover {
            background-color: #1f4f36;
        }

        .login-container-modal .links {
            text-align: center;
            margin-top: 0.8rem;
        }

        .login-container-modal .links a {
            color: #2c6e49;
            text-decoration: none;
            font-size: 0.8rem;
        }

        .login-container-modal .links a:hover {
            text-decoration: underline;
        }

        /* Forgot password styling */
        .forgot-password {
            display: block;
            text-align: center;
            font-size: 0.75rem;
            color: #2c6e49;
            margin-top: 0.8rem;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <!-- Background Content -->
    <div class="background"></div>

    <!-- Navbar Section -->
    <div class="navbar">
        <a href="BookSaleTest.html"> <!-- Make the logo clickable -->
            <h1>BookSale</h1>
        </a>
        <div class="login-container">
            <!-- Login Button that triggers the modal -->
            <button class="login-button" id="open-login-modal">Login</button>
        </div>
    </div>

    <!-- Modal Background -->
    <div class="modal-background" id="login-modal">
        <!-- Login Modal Content -->
        <div class="login-container-modal">
            <h2>Sign In</h2>
            <form action="login-process.html" method="post">
                <input type="email" name="email" placeholder="Email" required>
                <input type="password" name="password" placeholder="Password" required>
                <a href="reset-password.html" class="forgot-password">Forgot password?</a>
                <button type="submit">Sign In</button>
            </form>
            <div class="links">
                <!-- Register link with an ID of 'register-link' for JavaScript redirection -->
                <a href="BookSaleRegisterPage.html" id="register-link">Don't have an account? Register here</a>
            </div>
        </div>
    </div>

    <script>
    // Get modal elements
    const modal = document.getElementById("login-modal");
    const openModalButton = document.getElementById("open-login-modal");
    const registerLink = document.getElementById("register-link");

    // Open the modal when the login button is clicked
    openModalButton.addEventListener("click", () => {
        modal.style.display = "flex";  // Show modal
    });

    // Close the modal when clicked outside the modal content
    modal.addEventListener("click", (e) => {
        if (e.target === modal) {
            modal.style.display = "none"; // Hide modal
        }
    });
</script>


</body>
</html>
